      {
        "id": "api-runtime-contracts",
        "category": "framework-api",
        "purpose": "REST/OpenAPI, RPC, runtime SLO, context lifecycle, and discovery adapter contract evidence.",
        "gate": "make api-contract-check",
        "files": [
          "check-api-contract-governance.sh",
          "check-context-lifecycle-governance.sh",
          "check-discovery-adapter-matrix.sh",
          "check-openapi-validation-envelope.sh",
          "check-rpc-boundary.sh",
          "check-runtime-slo.sh"
        ]
      },
      {
        "id": "cli-layout-governance",
        "category": "tooling",
        "purpose": "CLI command surface, configuration, JSON contracts, framework gap reports, governance boundary inventory, layout checks, and aggregate governance reports.",
        "gate": "make governance-boundary-inventory-check",
        "files": [
          "check-cli-command-surface.sh",
          "check-cli-configuration-governance.sh",
          "check-cli-json-contract-goldens.sh",
          "check-framework-gap.sh",
          "check-governance-boundary-inventory.sh",
          "check-project-layout-governance.sh",
          "governance-10-rounds.sh",
          "governance-report.sh"
