      },
      {
        "id": "plugin-extension",
        "category": "extension-api",
        "purpose": "Plugin external process governance, registry conformance, permission checks, and failure isolation.",
        "gate": "make plugin-conformance-check",
        "files": [
          "check-plugin-external-governance.sh",
          "plugin-conformance-check.sh"
        ]
      }
    ]
  },
  "deployAssetBoundary": {
    "status": "blocking-contract",
    "policy": "Repository-level Kubernetes and Helm assets live only under deploy/. Top-level k8s/ and charts/ directories are retired and must not be reintroduced.",
    "requiredPaths": [
      "deploy/k8s",
      "deploy/helm/gofly"
    ],
    "forbiddenTopLevelPaths": [
      "k8s",
      "charts"
    ],
    "gate": "make project-layout-governance-check"
  },
  "runtimeIgnoredPaths": [
    ".aiflow/",
    ".harness/",
    ".tmp-test/",
    ".trae/",
    "coverage.out",
    "docs/superpowers/"
  ],
  "examplesGroupingPlan": {
    "status": "planned-only",
    "migrationPolicy": "Keep current examples/* paths stable until a future task migrates one family at a time and updates all gates in the same commit.",
    "groups": [
      {
        "id": "http",
        "futurePath": "examples/http/",
        "currentExamples": [
          "http-middleware",
          "middleware-demo",
          "middlewares",
          "restserver"
        ],
        "gate": "make p1-growth-check"
      },
      {
        "id": "rpc",
        "futurePath": "examples/rpc/",
        "currentExamples": [
          "gateway-discovery-rpc",
          "rpc-idl-matrix",
          "rpcserver"
        ],
        "gate": "make rpc-boundary-check"
      },
      {
        "id": "production",
        "futurePath": "examples/production/",
        "currentExamples": [
          "microshop",
          "production-orders",
          "k8s"
        ],
        "gate": "make reference-app-smoke"
      },
      {
        "id": "governance",
        "futurePath": "examples/governance/",
        "currentExamples": [
          "ai-governed-service",
          "migration-proof",
          "plugin-ecosystem",
          "resilience"
        ],
        "gate": "make governance-report-check"
      },
      {
        "id": "data",
        "futurePath": "examples/data/",
        "currentExamples": [
          "cache-local",
          "model-gorm",
          "model-mongo",
          "mq-worker",
          "observability",
          "outbox-mq",
          "saga",
          "config-discovery"
