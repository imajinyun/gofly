syntax = "v1"

type UpdateWidgetRequest {
  ID         string `path:"id"`
  LegacyName string `json:"legacyName"`
}

type WidgetResponse {
  ID string `json:"id"`
}

@server(prefix: /api/v1)
service widget-api {
  @doc(respCode: "200")
  @handler updateWidget
  put /widgets/:id (UpdateWidgetRequest) returns (WidgetResponse)
}
