syntax = "v1"

import (
	"types/common.api"
)

type (
	PerformanceRequest {
		RequestID string                 `header:"X-Request-ID"`
		TenantID  string                 `header:"X-Tenant-ID" validate:"required"`
		ID        string                 `path:"id" validate:"required"`
		Query     string                 `form:"q,optional" validate:"omitempty,min=1,max=128"`
		Page      PageRequest            `json:"page"`
		Payload   *Payload               `json:"payload,optional" validate:"omitempty"`
		Items     []*LineItem            `json:"items,optional" validate:"omitempty,min=1"`
		Labels    map[string]string      `json:"labels,optional"`
		Buckets   map[string][]*LineItem `json:"buckets,optional"`
		Audit     *AuditMetadata         `json:"audit,optional"`
	}
	PerformanceResponse {
		Item   *Payload            `json:"item,optional"`
		Items  []Payload           `json:"items"`
		Lookup map[string]*Payload `json:"lookup"`
		Page   PageResponse        `json:"page"`
		Error  *ErrorEnvelope      `json:"error,optional"`
	}
)

@server (
	prefix:     /api/v1/public
	group:      public
	jwt:        Auth
	middleware: Auth
)
service performance-api {
	@doc (
		respCode:  "200"
		responses: "200-OK<br>400-Invalid request<br>404-Resource not found"
	)
	@handler route0001
	get /resources/r0001/:id (PerformanceRequest) returns (PerformanceResponse)

	@doc (
		respCode:  "204"
		responses: "204-Deleted<br>400-Invalid request<br>401-Unauthorized<br>404-Resource not found"
	)
	@handler route0005
	delete /resources/r0005/:id (PerformanceRequest)

	@doc (
		respCode:  "202"
