syntax = "v1"

type UpdateWidgetRequest {
  ID   string `path:"widgetId"`
  Name string `json:"name"`
}

type WidgetResponse {
  ID string `json:"id"`
}

@server(prefix: /api/v1)
service widget-api {
  @doc(respCode: "200")
  @handler updateWidget
  put /widgets/:widgetId (UpdateWidgetRequest) returns (WidgetResponse)
}
