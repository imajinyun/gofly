{
  "schema": "gofly.goctl_migration_replay_sources.v1",
  "provenance": {
    "origin": "https://github.com/zeromicro/go-zero.git",
    "goctlModule": "tools/goctl",
    "pinnedCommit": "84c92d710b9f2ae11c3cbcee242cea40eec42e70",
    "goctlVersion": "1.10.2",
    "checkoutPolicy": "GOZERO_ROOT must resolve to this exact commit before a migration-proof replay runs. The oracle never fetches, mutates, or trusts an unpinned checkout.",
    "runtimePolicy": "Generated goctl projects replace github.com/zeromicro/go-zero with the checked-out pinned source during proof compilation."
  },
  "failureModeInventory": [
    {
      "id": "unpinned-goctl-source",
      "invariant": "The goctl checkout commit equals provenance.pinnedCommit.",
      "blocking": true
    },
    {
      "id": "fixture-source-drift",
      "invariant": "Every migration fixture file matches its recorded SHA-256 and aggregate source digest.",
      "blocking": true
    },
    {
      "id": "dual-generation-failure",
      "invariant": "Pinned goctl and gofly both generate API and model output from each fixture.",
      "blocking": true
    },
    {
      "id": "generated-module-does-not-compile",
      "invariant": "Both generated modules pass go mod tidy and go test ./... with isolated temporary caches.",
      "blocking": true
    },
    {
      "id": "http-contract-route-missing",
      "invariant": "The declared HTTP smoke route returns the expected status on both generated runtimes.",
      "blocking": true
    },
    {
      "id": "route-type-or-config-drift",
      "invariant": "Required route, type, and configuration evidence is present on both generated sides.",
      "blocking": true
    },
    {
      "id": "unclassified-generated-diff",
      "invariant": "Every file-set difference is recorded as a route, type, config, layout, model-layout, or compatible-addition classification.",
      "blocking": true
    }
  ],
